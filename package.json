{
  "name": "arena-server",
  "version": "1.0.0",
  "description": "Live quiz arena - synced questions, results and timers for many users",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "predev": "kill $(lsof -ti:3000 -sTCP:LISTEN) 2>/dev/null || true",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "start:test": "TIMER_SCALE=0.2 node src/server.js",
    "seed": "node scripts/seed.js",
    "play": "node scripts/play.cjs",
    "test": "node scripts/e2e.cjs",
    "test:ui": "playwright test",
    "test:ui:headed": "playwright test --headed",
    "test:load": "node scripts/load.cjs",
    "test:crash": "node scripts/crash-test.cjs",
    "test:concurrency": "node scripts/concurrency-test.cjs",
    "test:bots": "node scripts/bot-test.cjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "ioredis": "^5.11.1",
    "mongoose": "^8.9.5",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0"
  }
}
