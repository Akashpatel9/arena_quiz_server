# Copy to .env and adjust
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/arena
# Hot path for live-round answers (falls back to Mongo if unreachable)
REDIS_URL=redis://127.0.0.1:6379
# CDN prefix for question/option/solution image paths from the question bank
# (paths like "img/xyz.svg" are prefixed with this; leave empty to pass raw)
IMAGE_BASE_URL=

# Allowed CORS origins for Socket.IO. Comma-separated list in production
# (e.g. https://app.example.com,https://www.example.com), or "*" to allow any.
SOCKET_CORS_ORIGIN=*

# Reset ArenaGroup.online_user_count to 0 on boot.
# Safe for a single server; set to false when running multiple instances.
RESET_ONLINE_COUNTS=true

# Simulated players: 10-100 bots per arena that drift in/out and answer
# questions (accuracy by difficulty). Set to false to disable.
BOTS_ENABLED=true
